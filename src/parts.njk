---
layout: layout.njk
pagination:
  data: course.parts
  size: 1
  alias: part
permalink: "parts/{{ part.number }}/index.html"
eleventyComputed:
  title: "Part {{ part.number }} — {{ part.title }}"
  description: "{{ part.overview }}"
---
{% from "components/base-card.njk" import baseCard %}

<article class="mx-auto max-w-7xl px-6 py-12 sm:px-8 lg:px-12">
  <div class="mx-auto max-w-4xl">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
      <a href="/" class="hover:text-brand-700">All bases</a><span aria-hidden="true"> / </span><a href="{{ course.divisions[part.division - 1].url }}" class="hover:text-brand-700">Division {{ part.division }}</a>
    </nav>

    <header class="overflow-hidden rounded-3xl bg-gradient-to-br {{ part.gradient }} p-8 text-white shadow-soft sm:p-10">
      <p class="text-sm font-semibold uppercase tracking-[0.35em] {{ part.label }}">Part {{ part.number }} · Bases {{ part.from }}–{{ part.to }}</p>
      <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">{{ part.title }}</h1>
      <p class="mt-4 text-lg leading-8 text-white/90">{{ part.parable }}</p>
    </header>

    {% set doc = part.doc %}{% set body = part.doc.part_body %}{% set has_content = part.has_content %}
    {% set fallback_note = part.overview %}
    {% include "components/content-sections.njk" %}
  </div>

  <section aria-labelledby="part-bases-heading" class="mt-16">
    <h2 id="part-bases-heading" class="mb-6 text-2xl font-semibold text-slate-900">Bases in this part</h2>
    {% for group in bases | forPart(part.number) | superHappyGroups %}
      {% if group.label %}<h4 class="mb-4 {{ "mt-0" if loop.first else "mt-10" }} text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">{{ group.label }}</h4>{% endif %}
      <div data-masonry class="grid grid-cols-1 items-start gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {% for base in group.bases %}{{ baseCard(base) }}{% endfor %}
      </div>
      {% endfor %}
  </section>
</article>
