<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% if title != "whatis.foundation" %}{{ title }} | {% endif %}whatis.foundation</title>
    <meta name="description" content="{{ description or course.description }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css?v={{ cssVersion }}" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <div class="min-h-screen">
      <header class="border-b border-slate-200 bg-white/90 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 sm:px-8 lg:px-12">
          <a href="/" class="text-lg font-semibold tracking-tight text-slate-900">whatis.foundation</a>
          <p class="hidden text-sm text-slate-500 sm:block">{{ course.tagline }}</p>
        </div>
      </header>

      <main>{{ content | safe }}</main>
    </div>

    <footer class="border-t border-slate-200 bg-white py-8">
      <div class="mx-auto max-w-7xl px-6 text-sm text-slate-500 sm:px-8 lg:px-12">
        <p>Created for sacred education and community study.</p>
      </div>
    </footer>
  <script>
    (function () {
      var NAMES = { dt: 'Direct translation (DT)', nirv: 'NIrV', leb: 'LEB', original: 'Original language' };
      // Text size steps, as multiples of the base verse size (up to 6x, about 108px). The choice is shared by every list and remembered.
      var STEPS = [0.875, 1, 1.25, 1.5, 1.75, 2, 2.5, 3, 3.5, 4, 5, 6];
      var BIG_FROM = 2.5; // from here on a slide takes the full width instead of peeking
      var step = 1;
      try {
        var saved = localStorage.getItem('verseStep');
        if (saved !== null && !isNaN(Number(saved))) step = Math.max(0, Math.min(STEPS.length - 1, Number(saved)));
      } catch (e) {}

      function pressed(buttons, key) {
        [].slice.call(buttons).forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-set-version') === key || b.getAttribute('data-card-version') === key)); });
      }

      // Show one version of a scripture; a version it does not have falls back to its direct translation.
      function showVersion(card, key) {
        var verse = card.querySelector('[data-verse]');
        var shown = verse.querySelector('[data-v="' + key + '"]') || verse.querySelector('[data-v="dt"]');
        [].slice.call(verse.querySelectorAll('[data-v]')).forEach(function (p) { p.hidden = p !== shown; });
        var label = card.querySelector('[data-version-label]');
        var which = shown.getAttribute('data-v');
        // with no direct translation the DT verse is the LEB, and says so
        var shownName = which === 'dt' ? shown.getAttribute('data-label') : which;
        if (label) label.textContent = NAMES[shownName];
        pressed(card.querySelectorAll('[data-card-version]'), which);
      }

      // The slider is only as tall as the slide in view, so a short verse doesn't leave a gap under it.
      function fitSlider(track) {
        var box = track.getBoundingClientRect();
        var middle = box.left + box.width / 2;
        var nearest = null;
        [].slice.call(track.children).forEach(function (slide) {
          var r = slide.getBoundingClientRect();
          var distance = Math.abs(r.left + r.width / 2 - middle);
          if (!nearest || distance < nearest.distance) nearest = { slide: slide, distance: distance };
        });
        if (!nearest) return;
        var style = getComputedStyle(track);
        track.style.height = nearest.slide.offsetHeight + parseFloat(style.paddingTop) + parseFloat(style.paddingBottom) + 'px';
      }

      function applyScale() {
        var root = document.documentElement;
        root.style.setProperty('--verse-scale', STEPS[step]);
        if (STEPS[step] >= BIG_FROM) root.setAttribute('data-verse-big', ''); else root.removeAttribute('data-verse-big');
        [].slice.call(document.querySelectorAll('[data-font-readout]')).forEach(function (el) { el.textContent = Math.round(STEPS[step] * 100) + '%'; });
        [].slice.call(document.querySelectorAll('[data-font="-1"]')).forEach(function (b) { b.disabled = step === 0; });
        [].slice.call(document.querySelectorAll('[data-font="1"]')).forEach(function (b) { b.disabled = step === STEPS.length - 1; });
        [].slice.call(document.querySelectorAll('[data-slides]')).forEach(fitSlider);
      }

      [].slice.call(document.querySelectorAll('[data-scripture-list]')).forEach(function (root) {
        var cards = [].slice.call(root.querySelectorAll('[data-scripture]'));
        var track = root.querySelector('[data-slides]');
        var queued = false;
        function fit() { if (track) fitSlider(track); }
        if (track) {
          track.addEventListener('scroll', function () {
            if (queued) return;
            queued = true;
            requestAnimationFrame(function () { queued = false; fit(); });
          });
          window.addEventListener('resize', fit);
          window.addEventListener('load', fit);
        }
        cards.forEach(function (card) { showVersion(card, 'dt'); });
        fit();
        root.addEventListener('click', function (e) {
          var button = e.target.closest('button');
          if (!button || !root.contains(button)) return;
          var top = button.getAttribute('data-set-version');
          var one = button.getAttribute('data-card-version');
          var size = button.getAttribute('data-font');
          if (top) {
            pressed(root.querySelectorAll('[data-set-version]'), top);
            cards.forEach(function (card) { showVersion(card, top); });
          } else if (one) {
            // pressing the lit pill again goes back to the direct translation; a scripture's slide and list line move together
            var next = button.getAttribute('aria-pressed') === 'true' ? 'dt' : one;
            var id = button.closest('[data-scripture]').getAttribute('data-scripture');
            cards.filter(function (card) { return card.getAttribute('data-scripture') === id; }).forEach(function (card) { showVersion(card, next); });
          } else if (size) {
            step = Math.max(0, Math.min(STEPS.length - 1, step + Number(size)));
            applyScale();
            try { localStorage.setItem('verseStep', step); } catch (e) {}
          } else if (button.hasAttribute('data-slide-prev') || button.hasAttribute('data-slide-next')) {
            var slide = track.querySelector('li');
            var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
            track.scrollBy({ left: (button.hasAttribute('data-slide-next') ? 1 : -1) * (slide.getBoundingClientRect().width + gap), behavior: 'smooth' });
          }
          fit();
        });
      });

      applyScale();

      // A link to a scripture or its teacher notes opens that accordion item.
      function openHash() {
        var target = location.hash.length > 1 && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (target && target.tagName === 'DETAILS') {
          target.open = true;
          target.scrollIntoView();
        }
      }
      window.addEventListener('hashchange', openHash);
      openHash();
    })();
  </script>
  <script>
    (function () {
      var containers = [].slice.call(document.querySelectorAll('[data-masonry]'));
      if (!containers.length) return;
      containers.forEach(function (el) { el.items = [].slice.call(el.children); });

      function layout(el) {
        el.classList.remove('is-masonry');
        el.items.forEach(function (item) { el.appendChild(item); });
        [].slice.call(el.querySelectorAll(':scope > .masonry-col')).forEach(function (c) { c.remove(); });
        var count = getComputedStyle(el).gridTemplateColumns.split(' ').length;
        el.masonryCount = count;
        if (count < 2) return;
        el.classList.add('is-masonry');
        var cols = [];
        for (var i = 0; i < count; i++) {
          var col = document.createElement('div');
          col.className = 'masonry-col';
          el.appendChild(col);
          cols.push(col);
        }
        // deal in reading order: card 1 → column 1, card 2 → column 2 … then wrap to column 1
        el.items.forEach(function (item, i) { cols[i % count].appendChild(item); });
      }

      function columnsFor(el) {
        var was = el.classList.contains('is-masonry');
        el.classList.remove('is-masonry');
        var n = getComputedStyle(el).gridTemplateColumns.split(' ').length;
        if (was) el.classList.add('is-masonry');
        return n;
      }

      function run() { containers.forEach(layout); }
      run();
      window.addEventListener('load', run);
      window.addEventListener('resize', function () {
        containers.forEach(function (el) { if (columnsFor(el) !== el.masonryCount) layout(el); });
      });
    })();
  </script>
  </body>
</html>
