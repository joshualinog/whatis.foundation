{# Semantic card for one base. The title link is stretched over the whole card. #}
{% macro baseCard(base) %}
<article class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-white transition-all focus-within:ring-2 focus-within:ring-brand-500 hover:-translate-y-1 hover:shadow-soft">
  <header class="flex flex-col justify-end bg-gradient-to-br {{ base.accent.gradient if base.accent else 'from-slate-600 to-slate-800' }} p-5 pt-12">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] {{ base.accent.label if base.accent else 'text-slate-200' }}">
      Base {{ base.number }}{% if base.special %} · {{ base.special.role }}{% elif base.space %} · {{ base.space.name }}{% endif %}
    </p>
    <h3 class="mt-2 text-lg font-semibold leading-snug text-white">
      <a href="{{ base.url }}" class="after:absolute after:inset-0 after:content-[''] focus:outline-none">{{ base.long_title }}</a>
    </h3>
  </header>

  {% if base.main_image %}
  <figure>
    <img src="{{ base.main_image.src }}" alt="{{ base.main_image.alt }}" loading="lazy" class="w-full object-cover" />
  </figure>
  {% endif %}

  <div class="flex flex-col gap-3 p-5">
    {% if base.short_description %}
    <p class="text-sm font-medium leading-6 text-slate-800">{{ base.short_description }}</p>
    {% elif base.special %}
    <p class="text-sm leading-6 text-slate-600">{{ base.special.note }}</p>
    {% endif %}
  </div>

  <footer class="flex items-center justify-between border-t border-slate-100 px-5 py-3 text-xs text-slate-500">
    <span>{% if base.part %}Part {{ base.part.number }}{% else %}{{ base.special.role }}{% endif %}</span>
    <span class="font-semibold text-brand-700 group-hover:text-brand-900" aria-hidden="true">Open base →</span>
  </footer>
</article>
{% endmacro %}
