{# Sections shared by part, division and overview pages. Expects: doc, body, has_content, fallback_note #}
{% import "components/base-properties.njk" as p %}
{{ p.descriptions(doc, fallback_note) }}
{{ p.mainVideo(doc) }}
{{ p.images(doc) }}
{{ p.links(doc) }}
{{ p.notes(body) }}
{{ p.scriptures(doc) }}
{{ p.outline(doc) }}
{{ p.lexicon(doc) }}
{{ p.practices(doc) }}
{{ p.catechesis(doc) }}
{{ p.handGistures(doc) }}
{{ p.mindMovies(doc) }}
{{ p.media(doc) }}
{{ p.resources(doc, ['block_talk_content', 'homeschooling_supporting_content', 'board_game_content', 'childrens_content', 'base_sketch', 'part_sketch', 'division_sketch', 'overview_sketch']) }}

{% if not has_content %}
<p class="mt-12 rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-center text-slate-500">The teaching content here is still being written.</p>
{% endif %}
