{# One macro per base property, so pages can arrange them. `sub` = 'bare' renders just the content (the base page supplies its own small label); items then use h5. #}
{% from "components/base-sections.njk" import section %}

{% macro descriptions(doc, fallback_note="") %}
{% if doc.short_description or doc.long_description %}
<div class="mt-10 space-y-4">
  {% if doc.short_description %}<p class="text-xl font-medium leading-8 text-slate-900">{{ doc.short_description }}</p>{% endif %}
  {% if doc.long_description %}<p class="whitespace-pre-line leading-7 text-slate-600">{{ doc.long_description }}</p>{% endif %}
</div>
{% elif fallback_note %}
<p class="mt-10 text-lg leading-8 text-slate-600">{{ fallback_note }}</p>
{% endif %}
{% endmacro %}

{% macro descriptionShort(doc, fallback_note="") %}
{% if doc.short_description %}
<p class="mt-10 text-xl font-medium leading-8 text-slate-900">{{ doc.short_description }}</p>
{% elif not doc.long_description and fallback_note %}
<p class="mt-10 text-lg leading-8 text-slate-600">{{ fallback_note }}</p>
{% endif %}
{% endmacro %}

{% macro descriptionLong(doc) %}
{% if doc.long_description %}
<p class="mt-10 whitespace-pre-line leading-7 text-slate-600">{{ doc.long_description }}</p>
{% endif %}
{% endmacro %}

{% macro videos(doc) %}
{% if doc.videos.length %}
<div class="mt-8 space-y-6">
  {% for video in doc.videos %}{% if video.src %}
  <figure>
    <video controls preload="metadata" class="w-full rounded-2xl bg-black" src="{{ video.src }}"></video>
    {% if video.alt %}<figcaption class="mt-2 text-sm text-slate-500">{{ video.alt }}</figcaption>{% endif %}
  </figure>
  {% endif %}{% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro mainVideo(doc) %}
{% if doc.main_video %}
<figure class="mt-8">
  <video controls preload="metadata" class="w-full rounded-2xl bg-black" src="{{ doc.main_video.src }}"></video>
  {% if doc.main_video.alt %}<figcaption class="mt-2 text-sm text-slate-500">{{ doc.main_video.alt }}</figcaption>{% endif %}
</figure>
{% endif %}
{% endmacro %}

{% macro images(doc) %}
{% if doc.images.length %}
<div class="mt-8 columns-1 gap-4 sm:columns-2">
  {% for image in doc.images %}
  {% if image.src %}
  <figure class="mb-4 break-inside-avoid overflow-hidden rounded-2xl border border-slate-200 bg-white">
    <img src="{{ image.src }}" alt="{{ image.alt }}" loading="lazy" class="w-full" />
    {% if image.alt %}<figcaption class="px-4 py-2 text-sm text-slate-500">{{ image.alt }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{# `list` is [{ url, label }…]; without it every material link on the document is shown. #}
{% macro links(doc, list=null) %}
{% set all = list or [
  { url: doc.google_docs_url, label: 'Google Doc' },
  { url: doc.google_slides_url, label: 'Google Slides' },
  { url: doc.booklet_chapter_url, label: 'Booklet chapter' },
  { url: doc.childrens_book_url, label: 'Children’s book' }
] %}
{% set shown = [] %}{% for link in all %}{% if link.url %}{% set shown = (shown.push(link), shown) %}{% endif %}{% endfor %}
{% if shown.length %}
<nav aria-label="Materials" class="mt-6 flex flex-wrap gap-3">
  {% for link in shown %}
  <a href="{{ link.url }}" rel="noopener" class="rounded-full border border-brand-200 bg-brand-50 px-4 py-2 text-sm font-semibold text-brand-800 transition hover:bg-brand-100">{{ link.label }}</a>
  {% endfor %}
</nav>
{% endif %}
{% endmacro %}

{% macro notes(body, sub=false) %}
{% if body and sub == 'bare' %}
<div class="base-prose">{{ body | markdown | safe }}</div>
{% elif body %}
<section aria-labelledby="notes-heading" class="prose-base mt-12">
  <h2 id="notes-heading" class="mb-4 text-2xl font-semibold text-slate-900">Notes</h2>
  <div class="base-prose">{{ body | markdown | safe }}</div>
</section>
{% endif %}
{% endmacro %}

{% macro scriptures(doc, sub=false) %}
{% set ih = 'h5' if sub else 'h3' %}
{% if doc.scripture_list.length %}
{% call section('scriptures', 'Scripture', sub) %}
  <ul class="space-y-4">
    {% for s in doc.scripture_list %}
    <li class="rounded-2xl border {{ 'border-brand-300 bg-brand-50' if s.essential else 'border-slate-200 bg-white' }} p-5">
      <div class="flex flex-wrap items-center gap-3">
        <{{ ih }} class="text-lg font-semibold text-slate-900">{{ s.ref }}</{{ ih }}>
        {% if s.essential %}<span class="rounded-full bg-brand-600 px-3 py-0.5 text-xs font-semibold text-white">Essential</span>{% endif %}
      </div>
      {% if s.text %}<blockquote class="mt-3 whitespace-pre-line border-l-4 border-slate-200 pl-4 leading-7 text-slate-700">{{ s.text }}</blockquote>{% endif %}
      {% if s.teacher_notes %}<p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-500"><span class="font-semibold text-slate-600">Teacher notes:</span> {{ s.teacher_notes }}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro outline(doc, sub=false) %}
{% if doc.outline_chain.length %}
{% call section('outline', 'Outline', sub) %}
  <ol class="space-y-4">
    {% for link in doc.outline_chain %}
    <li class="rounded-2xl border border-slate-200 bg-white p-5">
      <p class="font-semibold text-slate-900">{{ link.text }}</p>
      {% if link.notes %}<p class="mt-1 whitespace-pre-line text-sm text-slate-500">{{ link.notes }}</p>{% endif %}
      {% if link.sublinks.length %}
      <ol class="mt-3 space-y-2 border-l-2 border-slate-100 pl-4">
        {% for sub in link.sublinks %}
        <li>
          <p class="text-slate-700">{{ sub.text }}</p>
          {% if sub.notes %}<p class="whitespace-pre-line text-sm text-slate-500">{{ sub.notes }}</p>{% endif %}
          {% if sub.base_prop_refs.length %}<ul class="mt-1 flex flex-wrap gap-2">{% for ref in sub.base_prop_refs %}<li class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-600">{{ ref }}</li>{% endfor %}</ul>{% endif %}
        </li>
        {% endfor %}
      </ol>
      {% endif %}
    </li>
    {% endfor %}
  </ol>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro lexicon(doc, sub=false) %}
{% if doc.concept_lexicon.length %}
{% call section('lexicon', 'Concept lexicon', sub) %}
  <dl class="grid gap-4 sm:grid-cols-2">
    {% for entry in doc.concept_lexicon %}
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      {% if entry.image %}<img src="{{ entry.image }}" alt="" loading="lazy" class="mb-3 w-full rounded-xl" />{% endif %}
      <dt class="text-lg font-semibold text-slate-900">{{ entry.term }}</dt>
      <dd class="mt-1 whitespace-pre-line leading-7 text-slate-600">{{ entry.definition }}</dd>
      {% if entry.references.length %}
      <dd class="mt-3 flex flex-wrap gap-2 text-xs">
        <span class="text-slate-400">See also:</span>
        {% for ref in entry.references %}{% set refNumber = ref | baseNumber %}{% if refNumber !== none %}<a href="/bases/{{ refNumber }}/" class="rounded-full bg-slate-100 px-2.5 py-0.5 font-semibold text-slate-700 hover:bg-brand-100">Base {{ refNumber }}</a>{% else %}<span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-slate-500">{{ ref }}</span>{% endif %}{% endfor %}
      </dd>
      {% endif %}
    </div>
    {% endfor %}
  </dl>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro practices(doc, sub=false) %}
{% set ih = 'h5' if sub else 'h3' %}
{% if doc.practices.length %}
{% call section('practices', 'Practices', sub) %}
  <div class="space-y-6">
    {% for practice in doc.practices %}
    <article class="rounded-2xl border border-slate-200 bg-white p-6">
      <{{ ih }} class="text-xl font-semibold text-slate-900">{{ practice.name }}</{{ ih }}>
      {% if practice.description %}<p class="mt-2 whitespace-pre-line leading-7 text-slate-600">{{ practice.description }}</p>{% endif %}
      {% if practice.steps.length %}
      <ol class="mt-4 space-y-4">
        {% for step in practice.steps %}
        <li class="flex gap-4">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-brand-600 text-sm font-semibold text-white">{{ step.number or loop.index }}</span>
          <div class="space-y-2">
            <p class="whitespace-pre-line leading-7 text-slate-700">{{ step.instructions }}</p>
            {% for image in step.images %}{% if image.src %}<img src="{{ image.src }}" alt="{{ image.alt }}" loading="lazy" class="max-w-xs rounded-xl" />{% endif %}{% endfor %}
          </div>
        </li>
        {% endfor %}
      </ol>
      {% endif %}
    </article>
    {% endfor %}
  </div>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro catechesis(doc, sub=false) %}
{% if doc.mishnah_catechesis.length %}
{% call section('catechesis', 'Mishnah catechesis', sub) %}
  <ol class="space-y-4">
    {% for item in doc.mishnah_catechesis %}
    <li class="rounded-2xl border border-slate-200 bg-white p-5">
      {% if item.hand_gisture %}<p class="mb-2 text-xs font-semibold uppercase tracking-[0.25em] text-brand-600">Hand gisture: {{ item.hand_gisture }}</p>{% endif %}
      <p class="font-semibold text-slate-900">{{ item.question }}</p>
      <p class="mt-1 leading-7 text-slate-700">{{ item.answer }}</p>
      {% if item.notes %}<p class="mt-2 whitespace-pre-line text-sm text-slate-500">{{ item.notes }}</p>{% endif %}
    </li>
    {% endfor %}
  </ol>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro handGistures(doc, sub=false) %}
{% set ih = 'h5' if sub else 'h3' %}
{% if doc.hand_gistures.length %}
{% call section('hand-gistures', 'Hand gistures', sub) %}
  <div class="grid gap-4 sm:grid-cols-2">
    {% for gisture in doc.hand_gistures %}
    <article class="rounded-2xl border border-slate-200 bg-white p-5">
      <{{ ih }} class="text-lg font-semibold text-slate-900">{{ gisture.name }}</{{ ih }}>
      {% if gisture.description %}<p class="mt-1 whitespace-pre-line text-slate-600">{{ gisture.description }}</p>{% endif %}
      {% if gisture.steps.length %}
      <ol class="mt-3 list-decimal space-y-3 pl-5 text-slate-700">
        {% for step in gisture.steps %}
        <li>{{ step.text }}{% if step.image %}<img src="{{ step.image }}" alt="" loading="lazy" class="mt-2 max-w-[12rem] rounded-xl" />{% endif %}</li>
        {% endfor %}
      </ol>
      {% endif %}
    </article>
    {% endfor %}
  </div>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro mindMovies(doc, sub=false) %}
{% if doc.mind_movies.length %}
{% call section('mind-movies', 'Mind movies', sub) %}
  <ol class="space-y-4">
    {% for movie in doc.mind_movies %}
    <li class="rounded-2xl border border-slate-200 bg-white p-5">
      {% if movie.text %}<p class="whitespace-pre-line leading-7 text-slate-700">{{ movie.text }}</p>{% endif %}
      {% for track in movie.track_urls %}<audio controls preload="none" src="{{ track }}" class="mt-3 w-full"></audio>{% endfor %}
      {% if movie.notes %}<p class="mt-2 whitespace-pre-line text-sm text-slate-500">{{ movie.notes }}</p>{% endif %}
    </li>
    {% endfor %}
  </ol>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro media(doc, sub=false) %}
{% if doc.youtube.length or doc.podcast.length %}
{% call section('media', 'Watch & listen', sub) %}
  <ul class="space-y-2">
    {% for v in doc.youtube %}<li><a href="{{ v.src }}" rel="noopener" class="font-medium text-brand-700 underline decoration-brand-200 underline-offset-4 hover:text-brand-900">▶ {{ v.alt or v.src }}</a></li>{% endfor %}
    {% for p in doc.podcast %}<li><a href="{{ p.src }}" rel="noopener" class="font-medium text-brand-700 underline decoration-brand-200 underline-offset-4 hover:text-brand-900">🎧 {{ p.alt or p.src }}</a></li>{% endfor %}
  </ul>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro youtube(doc, sub=false) %}
{% if doc.youtube.length %}
{% call section('youtube', 'YouTube', sub) %}
  <ul class="space-y-2">
    {% for v in doc.youtube %}<li><a href="{{ v.src }}" rel="noopener" class="font-medium text-brand-700 underline decoration-brand-200 underline-offset-4 hover:text-brand-900">▶ {{ v.alt or v.src }}</a></li>{% endfor %}
  </ul>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro podcast(doc, sub=false) %}
{% if doc.podcast.length %}
{% call section('podcast', 'Podcast', sub) %}
  <ul class="space-y-2">
    {% for p in doc.podcast %}<li><a href="{{ p.src }}" rel="noopener" class="font-medium text-brand-700 underline decoration-brand-200 underline-offset-4 hover:text-brand-900">🎧 {{ p.alt or p.src }}</a></li>{% endfor %}
  </ul>
{% endcall %}
{% endif %}
{% endmacro %}

{% macro resources(doc, keys, sub=false) %}
{% set ih = 'h5' if sub else 'h3' %}
{% for group in [
    { key: 'block_talk_content', label: 'Block talk' },
    { key: 'homeschooling_supporting_content', label: 'Homeschooling' },
    { key: 'board_game_content', label: 'Board game' },
    { key: 'childrens_content', label: 'Children’s content' },
    { key: 'base_sketch', label: 'Base sketch' },
    { key: 'part_sketch', label: 'Part sketch' },
    { key: 'division_sketch', label: 'Division sketch' },
    { key: 'overview_sketch', label: 'Overview sketch' }
  ] %}{% if group.key in keys %}

  {% set items = doc[group.key] %}
  {% if items.length %}
  {% call section(group.key, group.label, sub) %}
    <div class="grid gap-4 sm:grid-cols-2">
      {% for item in items %}
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <{{ ih }} class="text-lg font-semibold text-slate-900">{% if item.url %}<a href="{{ item.url }}" rel="noopener" class="hover:text-brand-700">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</{{ ih }}>
        {% if item.text %}<p class="mt-2 whitespace-pre-line leading-7 text-slate-600">{{ item.text }}</p>{% endif %}
        {% for src in item.image_urls %}<img src="{{ src }}" alt="" loading="lazy" class="mt-3 w-full rounded-xl" />{% endfor %}
        {% for src in item.video_urls %}<video controls preload="none" src="{{ src }}" class="mt-3 w-full rounded-xl"></video>{% endfor %}
        {% for src in item.audio_urls %}<audio controls preload="none" src="{{ src }}" class="mt-3 w-full"></audio>{% endfor %}
        {% if item.notes %}<p class="mt-3 whitespace-pre-line text-sm text-slate-500">{{ item.notes }}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
  {% endcall %}
  {% endif %}
  {% endif %}{% endfor %}
{% endmacro %}
