{# Titled section wrapper: {% call section(id, heading) %}…{% endcall %}. With sub=true it is a subheading (h3) inside a group. #}
{% macro section(id, heading, sub=false) %}
{% if sub == 'bare' %}{{ caller() }}
{% else %}<section id="{{ id }}" aria-labelledby="{{ id }}-heading" class="{{ 'mt-8' if sub else 'mt-12' }}">
  {% if sub %}<h3 id="{{ id }}-heading" class="mb-3 text-xl font-semibold text-slate-900">{{ heading }}</h3>
  {% else %}<h2 id="{{ id }}-heading" class="mb-4 text-2xl font-semibold text-slate-900">{{ heading }}</h2>{% endif %}
  {{ caller() }}
</section>{% endif %}
{% endmacro %}

{# A small all-caps label with the property's content under it, or a tiny "Content coming soon" when there is none. #}
{% macro prop(id, label) %}
{% set inner = caller() | trim %}
<section id="{{ id }}" aria-labelledby="{{ id }}-label" class="mt-8">
  <h4 id="{{ id }}-label" class="text-[11px] font-semibold uppercase tracking-[0.3em] text-slate-600">{{ label }}</h4>
  {% if inner | length %}<div class="mt-3">{{ inner | safe }}</div>{% else %}<p class="mt-1 text-[10px] text-slate-400">Content coming soon</p>{% endif %}
</section>
{% endmacro %}
