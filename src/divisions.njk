---
layout: layout.njk
pagination:
  data: course.divisions
  size: 1
  alias: division
permalink: "divisions/{{ division.number }}/index.html"
eleventyComputed:
  title: "Division {{ division.number }} — {{ division.title }}"
  description: "{{ division.summary }}"
---
<article class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
    <a href="/" class="hover:text-brand-700">All bases</a>
  </nav>

  <header class="overflow-hidden rounded-3xl bg-gradient-to-br from-slate-700 to-slate-900 p-8 text-white shadow-soft sm:p-10">
    <p class="text-sm font-semibold uppercase tracking-[0.35em] text-slate-300">Division {{ division.number }}</p>
    <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">{{ division.title }}</h1>
    <p class="mt-4 text-lg leading-8 text-white/90">{{ division.scripture }}</p>
  </header>

  {% set doc = division.doc %}{% set body = division.doc.division_body %}{% set has_content = division.has_content %}
  {% set fallback_note = division.summary %}
  {% include "components/content-sections.njk" %}

  <section aria-labelledby="division-parts-heading" class="mt-16">
    <h2 id="division-parts-heading" class="mb-4 text-2xl font-semibold text-slate-900">Parts</h2>
    <ul class="space-y-3">
      {% for partNumber in division.parts %}{% set part = course.parts[partNumber - 1] %}
      <li><a href="{{ part.url }}" class="block rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-brand-300">
        <span class="text-xs uppercase tracking-[0.25em] text-slate-400">Part {{ part.number }} · Bases {{ part.from }}–{{ part.to }}</span>
        <span class="mt-1 block text-lg font-semibold text-slate-900">{{ part.title }}</span>
      </a></li>
      {% endfor %}
    </ul>
  </section>
</article>
