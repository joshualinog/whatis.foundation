---
layout: layout.njk
title: "whatis.foundation"
---
{% from "components/base-card.njk" import baseCard %}

<section class="mx-auto max-w-7xl px-6 py-16 sm:px-8 lg:px-12">

  <div class="mb-16 space-y-4 text-center">
    <p class="text-sm uppercase tracking-[0.35em] text-brand-600">A Sacred Educational Course</p>
    <h1 class="text-5xl font-semibold tracking-tight text-slate-900 sm:text-6xl">{{ course.heading }}</h1>
    <p class="mx-auto max-w-3xl text-lg leading-8 text-slate-600">{{ course.description }}</p>
    <p><a href="{{ course.overview.url }}" class="text-sm font-semibold text-brand-700 underline decoration-brand-200 underline-offset-4 hover:text-brand-900">Course overview →</a></p>
  </div>

  {# Base 0 — introduction #}
  <section aria-labelledby="intro-heading" class="mb-20">
    <h2 id="intro-heading" class="sr-only">Introduction</h2>
    <div class="mx-auto max-w-md">
      {{ baseCard(bases[0]) }}
    </div>
  </section>

  {% for division in course.divisions %}
  <section id="division-{{ division.number }}" aria-labelledby="division-{{ division.number }}-heading" class="mb-20">
    <header class="mb-10 border-l-4 border-brand-500 pl-6">
      <p class="text-sm uppercase tracking-[0.35em] text-brand-600">Division {{ division.number }}</p>
      <h2 id="division-{{ division.number }}-heading" class="mt-2 text-4xl font-semibold text-slate-900"><a href="{{ division.url }}" class="hover:text-brand-700">{{ division.title }}</a></h2>
      <p class="mt-3 max-w-3xl text-lg leading-8 text-slate-600">{{ division.summary }}</p>
      {% if division.points.length %}
      <ul class="mt-3 max-w-3xl list-disc space-y-1 pl-5 text-slate-600">
        {% for point in division.points %}<li>{{ point }}</li>{% endfor %}
      </ul>
      {% endif %}
      <p class="mt-3 text-sm font-medium text-slate-500">{{ division.scripture }}</p>
    </header>

    {% for partNumber in division.parts %}
    {% set part = course.parts[partNumber - 1] %}
    <section id="part-{{ part.number }}" aria-labelledby="part-{{ part.number }}-heading" class="mb-14">
      <header class="mb-8 rounded-3xl border border-slate-200 bg-white p-8 shadow-soft">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
          <div class="lg:max-w-md">
            <p class="text-sm uppercase tracking-[0.35em] text-brand-600">Part {{ part.number }} · Bases {{ part.from }}–{{ part.to }}</p>
            <h3 id="part-{{ part.number }}-heading" class="mt-2 text-3xl font-semibold text-slate-900"><a href="{{ part.url }}" class="hover:text-brand-700">{{ part.title }}</a></h3>
            <p class="mt-2 text-sm text-slate-500">{{ part.parable }}</p>
          </div>
          <div class="max-w-2xl">
            <p class="leading-7 text-slate-600">{{ part.overview }}</p>
          </div>
        </div>
      </header>

      <div class="columns-1 gap-5 sm:columns-2 lg:columns-3 xl:columns-4">
        {% for base in bases | forPart(part.number) %}
        {{ baseCard(base) }}
        {% endfor %}
      </div>
    </section>
    {% endfor %}

    {# Base 30 — the nexus sits between the two divisions #}
    {% if division.number == 1 %}
    <section id="nexus" aria-labelledby="nexus-heading" class="mt-20">
      <h2 id="nexus-heading" class="mb-6 text-center text-sm uppercase tracking-[0.35em] text-brand-600">The Nexus: Jesus, the Only Foundation</h2>
      <div class="mx-auto max-w-md">{{ baseCard(bases[30]) }}</div>
    </section>
    {% endif %}
  </section>
  {% endfor %}

  {# Base 101 — laying on of hands #}
  <section aria-labelledby="ceremony-heading" class="mb-4">
    <h2 id="ceremony-heading" class="mb-6 text-center text-sm uppercase tracking-[0.35em] text-brand-600">The Ceremony</h2>
    <div class="mx-auto max-w-md">{{ baseCard(bases[101]) }}</div>
  </section>

</section>
