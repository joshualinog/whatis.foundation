---
layout: layout.njk
permalink: "overview/index.html"
title: "Course overview"
---
<article class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-500">
    <a href="/" class="hover:text-brand-700">All bases</a>
  </nav>

  <header class="overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-900 p-8 text-white shadow-soft sm:p-10">
    <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-100">Course overview</p>
    <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">{{ course.heading }}</h1>
    <p class="mt-4 text-lg leading-8 text-white/90">{{ course.tagline }}</p>
  </header>

  {% set doc = course.overview.doc %}{% set body = course.overview.doc.overview_body %}{% set has_content = course.overview.has_content %}
  {% set fallback_note = course.description %}
  {% include "components/content-sections.njk" %}

  <section aria-labelledby="overview-divisions-heading" class="mt-16">
    <h2 id="overview-divisions-heading" class="mb-4 text-2xl font-semibold text-slate-900">The two divisions</h2>
    <ul class="space-y-3">
      {% for division in course.divisions %}
      <li><a href="{{ division.url }}" class="block rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-brand-300">
        <span class="text-xs uppercase tracking-[0.25em] text-slate-400">Division {{ division.number }}</span>
        <span class="mt-1 block text-lg font-semibold text-slate-900">{{ division.title }}</span>
      </a></li>
      {% endfor %}
    </ul>
  </section>
</article>
